# ─────────────── sources_manager command handlers ────────────────
def upsert_source_policy(owner_user_id: str, domain: str, policy: str, note: str = None):
    with db_connect() as conn:
        conn.execute(
            "INSERT INTO source_policies(owner_user_id, domain, policy, note, updated_at) "
            "VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP) "
            "ON CONFLICT(owner_user_id, domain) DO UPDATE SET "
            "policy=excluded.policy, note=excluded.note, updated_at=CURRENT_TIMESTAMP",
            (owner_user_id, domain, policy, note),
        )
        conn.commit()


def cmd_source_set(user_id: str, raw: str, policy: str) -> str:
    # Allow optional scope hint: domain.com | scope=household
    main, kv = parse_kv_pipe(raw)
    domain = normalize_domain(main)
    if not domain:
        return f"Usage: source {policy}: <domain> | scope=user|household|global"
    scope = kv.get("scope", "user").strip().lower()
    if scope not in {"user", "household", "global"}:
        scope = "user"
    owner = scope_to_owner(scope, user_id)
    note = kv.get("note")
    upsert_source_policy(owner, domain, policy, note=note)
    scope_lbl = "🏠 household" if owner == HOUSEHOLD_USER_ID else ("🌐 global" if owner == GLOBAL_OWNER_ID else "personal")
    return f"Source policy set: {domain} → {policy} ({scope_lbl})."


def cmd_source_remove(user_id: str, raw: str) -> str:
    main, kv = parse_kv_pipe(raw)
    domain = normalize_domain(main)
    if not domain:
        return "Usage: source remove: <domain> | scope=user|household|global"

    scope = kv.get("scope", "user").strip().lower()
    if scope not in {"user", "household", "global"}:
        scope = "user"
    owner = scope_to_owner(scope, user_id)

    with db_connect() as conn:
        cur = conn.execute(
            "DELETE FROM source_policies WHERE owner_user_id=? AND domain=?",
            (owner, domain),
        )
        conn.commit()
    return f"Removed {cur.rowcount} source policy for {domain}."


def cmd_source_list(user_id: str) -> str:
    owners = (user_id, HOUSEHOLD_USER_ID, GLOBAL_OWNER_ID)
    with db_connect() as conn:
        rows = conn.execute(
            "SELECT owner_user_id, domain, policy, updated_at FROM source_policies "
            "WHERE owner_user_id IN (?, ?, ?) "
            "ORDER BY owner_user_id, policy, domain",
            owners,
        ).fetchall()

    if not rows:
        return "No source policies set."

    lines = []
    for owner, domain, policy, ts in rows:
        badge = "🏠" if owner == HOUSEHOLD_USER_ID else ("🌐" if owner == GLOBAL_OWNER_ID else "👤")
        lines.append(f"{badge} {normalize_domain(domain)} → {policy} ({ts})")
    return "\n".join(lines)


# ─────────────────────────── Filter class ─────────────────────────
class Filter:
    def __init__(self):
        pass

    # ----------------------------- inlet -----------------------------
    def inlet(self, body: dict, __user__: dict = None):
        try:
            user_id = get_user_id(__user__)
            if not user_id:
                return body

            messages = body.get("messages", [])
            if not messages or messages[-1].get("role") != "user":
                return body

            last = messages[-1].get("content", "").strip()
            low = last.lower()

            # ----- memory commands -----
            if low.startswith("memory list:"):
                return self._reply_inline(body, cmd_list(user_id))
            if low.startswith("memory stats:"):
                return self._reply_inline(body, cmd_stats(user_id))
            if low.startswith("memory forget:"):
                arg = last.split(":", 1)[1]
                return self._reply_inline(body, cmd_forget(user_id, arg))
            if low.startswith("memory pin household:"):
                arg = last.split(":", 1)[1]
                return self._reply_inline(body, cmd_pin(user_id, arg, household=True))
            if low.startswith("memory pin:"):
                arg = last.split(":", 1)[1]
                return self._reply_inline(body, cmd_pin(user_id, arg))
            if low.startswith("memory mute:"):
                return self._reply_inline(body, cmd_mute(user_id, True))
            if low.startswith("memory unmute:"):
                return self._reply_inline(body, cmd_mute(user_id, False))
            if low.startswith("memory prune:"):
                return self._reply_inline(body, cmd_prune(user_id))
            if low.startswith("memory list pinned:"):
                return self._reply_inline(body, cmd_list_pinned(user_id))

            # ----- knowledge commands -----
            if low.startswith("knowledge add:"):
                arg = last.split(":", 1)[1]
                return self._reply_inline(body, cmd_knowledge_add(user_id, arg))
            if low.startswith("knowledge list:"):
                arg = last.split(":", 1)[1]
                return self._reply_inline(body, cmd_knowledge_list(user_id, arg))
            if low.startswith("knowledge forget:"):
                arg = last.split(":", 1)[1]
                return self._reply_inline(body, cmd_knowledge_forget(user_id, arg))
            if low.startswith("knowledge pin:"):
                arg = last.split(":", 1)[1]
                return self._reply_inline(body, cmd_knowledge_pin(user_id, arg))

            # ----- source commands -----
            if low.startswith("source prefer:"):
                arg = last.split(":", 1)[1]
                return self._reply_inline(body, cmd_source_set(user_id, arg, "prefer"))
            if low.startswith("source unreliable:"):
                arg = last.split(":", 1)[1]
                return self._reply_inline(body, cmd_source_set(user_id, arg, "unreliable"))
            if low.startswith("source block:"):
                arg = last.split(":", 1)[1]
                return self._reply_inline(body, cmd_source_set(user_id, arg, "block"))
            if low.startswith("source remove:"):
                arg = last.split(":", 1)[1]
                return self._reply_inline(body, cmd_source_remove(user_id, arg))
            if low.startswith("source list:") or low == "source list":
                return self._reply_inline(body, cmd_source_list(user_id))

            # ----- explicit recall -----
            m = re.match(r"^recall\s*[:\-]\s*(.+)$", last, re.I | re.S)
            if m:
                query = m.group(1).strip()
                mem_hits = search_memories(query, user_id, EXPLICIT_RECALL_MIN_SIM)
                know_hits = search_knowledge(query, user_id, KNOWLEDGE_EXPLICIT_MIN_SIM)
                src_txt = format_source_policy_summary(user_id)

                if mem_hits or know_hits:
                    block = build_context_block(query, mem_hits, know_hits, src_txt)
                    self._inject_system(messages, block)
                    messages[-1]["content"] = query
                    logger.info(
                        f"Explicit recall: mem={len(mem_hits)} knowledge={len(know_hits)} for {user_id}"
                    )
                return body

            # ----- automatic background recall -----
            query_text = re.sub(r"\s*--private\b", "", last).strip()
            mem_hits = search_memories(query_text, user_id, AUTO_RECALL_MIN_SIM)
            know_hits = search_knowledge(query_text, user_id, KNOWLEDGE_AUTO_MIN_SIM)
            src_txt = format_source_policy_summary(user_id)

            if mem_hits or know_hits:
                block = build_context_block(query_text, mem_hits, know_hits, src_txt)
                self._inject_system(messages, block)
                logger.info(
                    f"Auto recall: mem={len(mem_hits)} knowledge={len(know_hits)} for {user_id}"
                )

        except Exception as e:
            logger.error(f"inlet error: {e}")
        return body

    @staticmethod
    def _inject_system(messages: list, block: str):
        sys_msg = {
            "role": "system",
            "content": block,
        }
        messages.insert(len(messages) - 1, sys_msg)

    @staticmethod
    def _reply_inline(body: dict, text: str):
        messages = body.get("messages", [])
        if messages and messages[-1].get("role") == "user":
            messages[-1]["content"] = (
                "Respond with exactly the following text and nothing else, "
                "no preamble, no quoting, no commentary:\n\n"
                f"{text}"
            )
        body["_memory_short_circuit"] = True
        return body

    # ----------------------------- outlet ----------------------------
    def outlet(self, body: dict, __user__: dict = None):
        try:
            if body.get("_memory_short_circuit"):
                return body

            user_id = get_user_id(__user__)
            if not user_id:
                return body

            if user_id in _MUTED_USERS:
                return body

            messages = body.get("messages", [])
            if len(messages) < 2:
                return body

            asst = next((m for m in reversed(messages) if m.get("role") == "assistant"), None)
            if not asst:
                return body
            asst_text = asst.get("content", "").strip()
            if not asst_text:
                return body

            user = next((m for m in reversed(messages) if m.get("role") == "user"), None)
            if not user:
                return body

            user_text_raw = strip_recall_block(user.get("content", "")).strip()
            if not user_text_raw:
                return body

            # --private flag => do not store turn
            if "--private" in user_text_raw.lower():
                logger.info("Skipped storage due to --private flag")
                return body

            user_text = user_text_raw

            # Skip storing command outputs
            if re.match(r"^(recall|memory|knowledge|source)\s*[:\-]", user_text, re.I):
                return body

            summary = f"User: {user_text}\nAssistant: {asst_text}"
            v = embed(summary)
            if v is None:
                return body

            conv_id = get_conversation_id(body)

            with db_connect() as conn:
                recent = conn.execute(
                    "SELECT embedding FROM memories WHERE user_id=? "
                    "AND deleted_at IS NULL AND embedding_model=? AND embedding_dim=? "
                    "ORDER BY id DESC LIMIT 5",
                    (user_id, EMBED_MODEL_NAME, EMBED_DIM),
                ).fetchall()

                for (blob,) in recent:
                    if not blob:
                        continue
                    try:
                        prev = np.frombuffer(blob, dtype=np.float32)
                        if prev.shape[0] == EMBED_DIM and float(np.dot(v, prev)) > DEDUP_THRESHOLD:
                            logger.info("Skipped duplicate memory")
                            return body
                    except Exception:
                        continue

                conn.execute(
                    "INSERT INTO memories(user_id, conversation_id, user_msg, assistant_msg, summary, embedding, embedding_model, embedding_dim) "
                    "VALUES (?,?,?,?,?,?,?,?)",
                    (
                        user_id,
                        conv_id,
                        user_text,
                        asst_text,
                        summary,
                        v.tobytes(),
                        EMBED_MODEL_NAME,
                        EMBED_DIM,
                    ),
                )
                conn.commit()

            self._write_obsidian(conv_id, user_id, user_text, asst_text)
            logger.info(f"Stored memory for {user_id} (conv {conv_id[:8]})")

        except Exception as e:
            logger.error(f"outlet error: {e}")
        return body

    @staticmethod
    def _write_obsidian(conv_id: str, user_id: str, user_text: str, asst_text: str):
        try:
            short = hashlib.sha1(conv_id.encode()).hexdigest()[:8]
            date = datetime.now(timezone.utc).strftime("%Y%m%d")
            fname = f"{date}_{user_id[:8]}_{short}.md"
            path = os.path.join(VAULT_DIR, fname)
            ts = datetime.now(timezone.utc).isoformat(timespec="seconds")
            entry = (
                f"\n## {ts}\n\n"
                f"**User:** {user_text}\n\n"
                f"**Assistant:** {asst_text}\n"
            )
            mode = "a" if os.path.exists(path) else "w"
            with open(path, mode, encoding="utf-8") as f:
                if mode == "w":
                    f.write(f"# Conversation {conv_id}\n")
                f.write(entry)
        except Exception as e:
            logger.warning(f"Obsidian write failed: {e}")
