RECALL_BOOST_FACTOR = 0.01
TIME_DECAY_HALFLIFE_DAYS = 30
TIME_DECAY_MAX_PENALTY = 0.10
CACHE_TTL = 60

RECALL_BLOCK_MARKER = "Contextual Notes from previous discussion:"
