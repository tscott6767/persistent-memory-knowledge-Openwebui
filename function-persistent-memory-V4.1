        rows = conn.execute(
            "SELECT id, substr(summary,1,120), timestamp, user_id FROM memories "
            "WHERE user_id IN (?, ?) AND deleted_at IS NULL AND pinned = 1 ORDER BY id DESC LIMIT 20",
            (user_id, HOUSEHOLD_USER_ID)).fetchall()
    if not rows:
        return "No pinned memories found."
    return "\n".join(
        f"[{mid}]{' 🏠' if owner == HOUSEHOLD_USER_ID else ''} {ts} — {snip}…"
        for mid, snip, ts, owner in rows)


def cmd_knowledge_add(user_id, payload):
    content, kv = parse_kv_pipe(payload)
    content = content.strip()
    if not content:
        return "Usage: knowledge add: <text> | source=<url/domain> | confidence=0.8 | scope=user|household|global | tags=a,b"
    if MAX_KNOWLEDGE_CHARS and len(content) > MAX_KNOWLEDGE_CHARS:
        return f"Content too large ({len(content)} chars). Limit is {MAX_KNOWLEDGE_CHARS}. Split into smaller entries."
    source = kv.get("source", "").strip()
    source_domain = normalize_domain(source)
    title = kv.get("title", "").strip() or None
    tags = kv.get("tags", "").strip() or None
    try:
        confidence = float(kv.get("confidence", "0.7"))
    except Exception:
        confidence = 0.7
    confidence = min(1.0, max(0.0, confidence))
    scope = kv.get("scope", "user").strip().lower()
    if scope not in {"user", "household", "global"}:
        scope = "user"
    owner = scope_to_owner(scope, user_id)
    emb_text = f"{title or ''}\n{content}\nsource:{source_domain}"
    v = embed(emb_text)
    if v is None:
        return "Embedding model unavailable."
    with db_connect() as conn:
        cur = conn.execute(
            "INSERT INTO knowledge_items(owner_user_id, scope, title, content, source_url, source_domain, confidence, tags, embedding, embedding_model, embedding_dim) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
            (owner, scope, title, content, source if source else None,
             source_domain if source_domain else None, confidence, tags, v.tobytes(), EMBED_MODEL_NAME, EMBED_DIM))
        new_id = cur.lastrowid
        conn.commit()
    owner_label = "🏠 household" if owner == HOUSEHOLD_USER_ID else ("🌐 global" if owner == GLOBAL_OWNER_ID else "personal")
    src_label = source_domain if source_domain else "no-source"
    tag_info = f", tags={tags}" if tags else ""
    write_obsidian_knowledge(new_id, owner, title, content, tags, source_domain)
    return (f"✅ Stored as knowledge id={new_id} ({owner_label}, conf={round(confidence,2)}, "
            f"source={src_label}{tag_info}, len={len(content)}).\nRetrieve with: knowledge show: {new_id}")


def cmd_knowledge_list(user_id, query):
    query = (query or "").strip()
    if not query:
        with db_connect() as conn:
            rows = conn.execute(
                f"SELECT id, substr(content,1,{LIST_SNIPPET_CHARS}), source_domain, confidence, pinned, owner_user_id, timestamp, LENGTH(content) "
                "FROM knowledge_items WHERE owner_user_id IN (?, ?, ?) AND deleted_at IS NULL ORDER BY pinned DESC, id DESC LIMIT 20",
                (user_id, HOUSEHOLD_USER_ID, GLOBAL_OWNER_ID)).fetchall()
        if not rows:
            return "No knowledge items stored."
        out_lines = []
        for kid, snip, dom, conf, p, owner, ts, full_len in rows:
            badge = " 🏠" if owner == HOUSEHOLD_USER_ID else (" 🌐" if owner == GLOBAL_OWNER_ID else "")
            pin = " 📌" if p else ""
            more = "…" if full_len and full_len > LIST_SNIPPET_CHARS else ""
            out_lines.append(f"[{kid}]{pin}{badge} {ts} — conf={round(conf or 0.0,2)} src={dom or 'n/a'} len={full_len} — {snip}{more}")
        return "\n".join(out_lines)
    hits = search_knowledge(query, user_id, min_sim=0.0, top_k=20)
    if not hits:
        return "No matching knowledge items."
    lines = []
    for h in hits:
        lines.append(f"[{h['id']}] sim={round(h['sim'],3)} conf={round(h['confidence'],2)} src={h['domain'] or 'n/a'} — {truncate_words(h['content'], KNOWLEDGE_SEARCH_WORDS)}")
    return "\n".join(lines)


def cmd_knowledge_show(user_id, target):
    try:
        kid = int(target.strip())
    except ValueError:
        return "Usage: knowledge show: <id>"
    with db_connect() as conn:
        row = conn.execute(
            "SELECT id, owner_user_id, scope, title, content, source_url, source_domain, confidence, tags, pinned, timestamp, LENGTH(content) "
            "FROM knowledge_items WHERE id=? AND owner_user_id IN (?, ?, ?) AND deleted_at IS NULL",
            (kid, user_id, HOUSEHOLD_USER_ID, GLOBAL_OWNER_ID)).fetchone()
    if not row:
        return f"No knowledge item with id={kid} (or not accessible)."
    (kid, owner, scope, title, content, src_url, src_dom, conf, tags, pinned, ts, content_len) = row
    header = (f"id={kid} scope={scope} owner={owner} pinned={bool(pinned)}\n"
              f"title={title or '(none)'}\nsource_url={src_url or '(none)'} | source_domain={src_dom or '(none)'}\n"
              f"confidence={conf} tags={tags or '(none)'}\ntimestamp={ts} content_len={content_len}\n--- CONTENT ---\n")
    return header + (content or "")


def cmd_knowledge_forget(user_id, target):
    try:
        kid = int(target.strip())
    except ValueError:
        return "Usage: knowledge forget: <id>"
    with db_connect() as conn:
        cur = conn.execute(
            "UPDATE knowledge_items SET deleted_at=CURRENT_TIMESTAMP WHERE id=? AND owner_user_id IN (?, ?, ?) AND deleted_at IS NULL",
            (kid, user_id, HOUSEHOLD_USER_ID, GLOBAL_OWNER_ID))
        conn.commit()
    if cur.rowcount == 0:
        return f"No knowledge item with id={kid} found (or not yours)."
    return f"Forgotten knowledge id={kid}."


def cmd_knowledge_pin(user_id, target):
    try:
        kid = int(target.strip())
    except ValueError:
        return "Usage: knowledge pin: <id>"
    with db_connect() as conn:
        cur = conn.execute(
            "UPDATE knowledge_items SET pinned=1 WHERE id=? AND owner_user_id IN (?, ?, ?) AND deleted_at IS NULL",
            (kid, user_id, HOUSEHOLD_USER_ID, GLOBAL_OWNER_ID))
        conn.commit()
    if cur.rowcount == 0:
        return f"No knowledge item with id={kid} (or not yours)."
    return f"Pinned knowledge id={kid}."


def upsert_source_policy(owner_user_id, domain, policy, note=None):
    with db_connect() as conn:
        conn.execute(
            "INSERT INTO source_policies(owner_user_id, domain, policy, note, updated_at) VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP) "
            "ON CONFLICT(owner_user_id, domain) DO UPDATE SET policy=excluded.policy, note=excluded.note, updated_at=CURRENT_TIMESTAMP",
            (owner_user_id, domain, policy, note))
        conn.commit()


def cmd_source_set(user_id, raw, policy):
    main, kv = parse_kv_pipe(raw)
    domain = normalize_domain(main)
    if not domain:
        return f"Usage: source {policy}: <domain> | scope=user|household|global"
    scope = kv.get("scope", "user").strip().lower()
    if scope not in {"user", "household", "global"}:
        scope = "user"
    owner = scope_to_owner(scope, user_id)
    note = kv.get("note")
    upsert_source_policy(owner, domain, policy, note=note)
    scope_lbl = "🏠 household" if owner == HOUSEHOLD_USER_ID else ("🌐 global" if owner == GLOBAL_OWNER_ID else "personal")
    return f"Source policy set: {domain} → {policy} ({scope_lbl})."


def cmd_source_remove(user_id, raw):
    main, kv = parse_kv_pipe(raw)
    domain = normalize_domain(main)
    if not domain:
        return "Usage: source remove: <domain> | scope=user|household|global"
    scope = kv.get("scope", "user").strip().lower()
    if scope not in {"user", "household", "global"}:
        scope = "user"
    owner = scope_to_owner(scope, user_id)
    with db_connect() as conn:
        cur = conn.execute("DELETE FROM source_policies WHERE owner_user_id=? AND domain=?", (owner, domain))
        conn.commit()
    return f"Removed {cur.rowcount} source policy for {domain}."


def cmd_source_list(user_id):
    owners = (user_id, HOUSEHOLD_USER_ID, GLOBAL_OWNER_ID)
    with db_connect() as conn:
        rows = conn.execute(
            "SELECT owner_user_id, domain, policy, updated_at FROM source_policies "
            "WHERE owner_user_id IN (?, ?, ?) ORDER BY owner_user_id, policy, domain",
            owners).fetchall()
    if not rows:
        return "No source policies set."
    lines = []
    for owner, domain, policy, ts in rows:
        badge = "🏠" if owner == HOUSEHOLD_USER_ID else ("🌐" if owner == GLOBAL_OWNER_ID else "👤")
        lines.append(f"{badge} {normalize_domain(domain)} → {policy} ({ts})")
    return "\n".join(lines)


# ── v4.1 Feature 6: Obsidian vault subfolders ──

def write_obsidian_knowledge(kid, owner, title, content, tags_str, source_domain):
    try:
        full_detail_tags = load_full_detail_tags()
        mem_tags = _parse_tags(tags_str)
        matched = mem_tags & full_detail_tags
        if matched:
            subdir = sorted(matched)[0]
        else:
            subdir = "notes"
        folder = os.path.join(VAULT_DIR, subdir)
        os.makedirs(folder, exist_ok=True)
        date = datetime.now(timezone.utc).strftime("%Y%m%d")
        safe_title = re.sub(r'[^\w\s-]', '', title or '').strip().replace(' ', '-')[:50]
        if not safe_title:
            safe_title = f"item-{kid}"
        fname = f"{date}_{safe_title}.md"
        path = os.path.join(folder, fname)
        ts = datetime.now(timezone.utc).isoformat(timespec="seconds")
        lines = [
            f"# {title or 'Knowledge Item'}",
            f"**Date:** {ts}",
            f"**ID:** knowledge_{kid}",
            f"**Source:** {source_domain or 'unknown'}",
            f"**Tags:** {tags_str or 'none'}",
            "",
            content,
        ]
        with open(path, 'w', encoding="utf-8") as f:
            f.write("\n".join(lines))
    except Exception as e:
        logger.warning(f"Obsidian knowledge write failed: {e}")


# ─────────────────────────── Filter class ─────────────────────────
class Filter:
    def __init__(self):
        pass

    def inlet(self, body: dict, __user__: dict = None):
        try:
            user_id = get_user_id(__user__)
            if not user_id:
                return body
            messages = body.get("messages", [])
            if not messages or messages[-1].get("role") != "user":
                return body
            last_raw = messages[-1].get("content", "")
            last = _content_to_text(last_raw).strip()
            low = last.lower()

            alias = _alias_to_core(last, messages, user_id)
            if alias.get("reply"):
                return self._reply_inline(body, alias["reply"])
            if alias.get("command"):
                last = alias["command"].strip()
                messages[-1]["content"] = last
                low = last.lower()

            # v4.1 Feature 1: Tag management commands
            if low.startswith("memory tag full:"):
                return self._reply_inline(body, cmd_tag_full(last.split(":", 1)[1]))
            if low.startswith("memory tag unfull:"):
                return self._reply_inline(body, cmd_tag_unfull(last.split(":", 1)[1]))
            if low.startswith("memory tag list:"):
                return self._reply_inline(body, cmd_tag_list())

            # v4.1 Feature 7a: memory get command
            if low.startswith("memory get:"):
                return self._reply_inline(body, cmd_memory_get(user_id, last.split(":", 1)[1]))

            # memory commands
            if low.startswith("memory list pinned:"):
                return self._reply_inline(body, cmd_list_pinned(user_id))
            if low.startswith("memory list:"):
                return self._reply_inline(body, cmd_list(user_id))
            if low.startswith("memory search:"):
                return self._reply_inline(body, cmd_memory_search(user_id, last.split(":", 1)[1]))
            if low.startswith("memory transcript:"):
                return self._reply_inline(body, cmd_memory_transcript(user_id, last.split(":", 1)[1]))
            if low.startswith("memory stats:"):
                return self._reply_inline(body, cmd_stats(user_id))
            if low.startswith("memory forget:"):
                return self._reply_inline(body, cmd_forget(user_id, last.split(":", 1)[1]))
            if low.startswith("memory pin household:"):
                return self._reply_inline(body, cmd_pin(user_id, last.split(":", 1)[1], household=True))
            if low.startswith("memory pin:"):
                return self._reply_inline(body, cmd_pin(user_id, last.split(":", 1)[1]))
            if low.startswith("memory mute:"):
                return self._reply_inline(body, cmd_mute(user_id, True))
            if low.startswith("memory unmute:"):
                return self._reply_inline(body, cmd_mute(user_id, False))
            if low.startswith("memory prune:"):
                return self._reply_inline(body, cmd_prune(user_id))

            # knowledge commands
            if low.startswith("knowledge add:"):
                return self._reply_inline(body, cmd_knowledge_add(user_id, last.split(":", 1)[1]))
            if low.startswith("knowledge list:"):
                return self._reply_inline(body, cmd_knowledge_list(user_id, last.split(":", 1)[1]))
            if low.startswith("knowledge show:"):
                return self._reply_inline(body, cmd_knowledge_show(user_id, last.split(":", 1)[1]))
            if low.startswith("knowledge forget:"):
                return self._reply_inline(body, cmd_knowledge_forget(user_id, last.split(":", 1)[1]))
            if low.startswith("knowledge pin:"):
                return self._reply_inline(body, cmd_knowledge_pin(user_id, last.split(":", 1)[1]))

            # source commands
            if low.startswith("source prefer:"):
                return self._reply_inline(body, cmd_source_set(user_id, last.split(":", 1)[1], "prefer"))
            if low.startswith("source unreliable:"):
                return self._reply_inline(body, cmd_source_set(user_id, last.split(":", 1)[1], "unreliable"))
            if low.startswith("source block:"):
                return self._reply_inline(body, cmd_source_set(user_id, last.split(":", 1)[1], "block"))
            if low.startswith("source remove:"):
                return self._reply_inline(body, cmd_source_remove(user_id, last.split(":", 1)[1]))
            if low.startswith("source list:") or low == "source list":
                return self._reply_inline(body, cmd_source_list(user_id))

            # explicit recall
            m = re.match(r"^recall\s*[:\-]\s*(.+)$", last, re.I | re.S)
            if m:
                query = m.group(1).strip()
                conv_id = get_conversation_id(body)
                mem_hits = search_memories(query, user_id, EXPLICIT_RECALL_MIN_SIM, exclude_conversation_id=conv_id)
                know_hits = search_knowledge(query, user_id, KNOWLEDGE_EXPLICIT_MIN_SIM)
                src_txt = format_source_policy_summary(user_id)
                conv_expansion = None
                if mem_hits:
                    conv_memories = _expand_conversation_context(query, user_id)
                    if conv_memories:
                        conv_expansion = truncate_to_budget(_format_conversation_expansion(conv_memories), CONTEXT_EXPAND_TOKENS)
                if mem_hits or know_hits or conv_expansion:
                    block = build_context_block(query, mem_hits, know_hits, src_txt, conv_expansion)
                    self._inject_system(messages, block)
                    messages[-1]["content"] = query
                    logger.info(f"Explicit recall: mem={len(mem_hits)} knowledge={len(know_hits)} conv_expand={bool(conv_expansion)} for {user_id}")
                return body

            # automatic background recall
            query_text = re.sub(r"\s*--private\b", "", last).strip()
            conv_id = get_conversation_id(body)
            mem_hits = search_memories(query_text, user_id, AUTO_RECALL_MIN_SIM, exclude_conversation_id=conv_id)
            know_hits = search_knowledge(query_text, user_id, KNOWLEDGE_AUTO_MIN_SIM)
            src_txt = format_source_policy_summary(user_id)
            conv_expansion = None
            if mem_hits:
                conv_memories = _expand_conversation_context(query_text, user_id)
                if conv_memories:
                    conv_expansion = truncate_to_budget(_format_conversation_expansion(conv_memories), CONTEXT_EXPAND_TOKENS)
            if mem_hits or know_hits or conv_expansion:
                block = build_context_block(query_text, mem_hits, know_hits, src_txt, conv_expansion)
                self._inject_system(messages, block)
                logger.info(f"Auto recall: mem={len(mem_hits)} knowledge={len(know_hits)} conv_expand={bool(conv_expansion)} for {user_id}")

        except Exception as e:
            logger.error(f"inlet error: {e}")
        return body

    @staticmethod
    def _inject_system(messages: list, block: str):
        sys_msg = {"role": "system", "content": block}
        messages.insert(len(messages) - 1, sys_msg)

    @staticmethod
    def _reply_inline(body: dict, text: str):
        messages = body.get("messages", [])
        if messages and messages[-1].get("role") == "user":
            messages[-1]["content"] = (
                "Respond with exactly the following text and nothing else, "
                "no preamble, no quoting, no commentary:\n\n"
                f"{text}"
            )
        body["_memory_short_circuit"] = True
        return body

    def outlet(self, body: dict, __user__: dict = None):
        logger.info(f"OUTLET_FIRED keys={list(body.keys()) if isinstance(body, dict) else 'N/A'}")
        try:
            if body.get("_memory_short_circuit"):
                logger.info("OUTLET_EXIT: short_circuit")
                return body
            user_id = get_user_id(__user__)
            if not user_id:
                logger.info("OUTLET_EXIT: no user_id")
                return body
            if user_id in _MUTED_USERS:
                logger.info("OUTLET_EXIT: muted")
                return body
            messages = body.get("messages", [])
            logger.info(f"OUTLET_MSGS: count={len(messages)}")
            if len(messages) < 2:
                logger.info("OUTLET_EXIT: too few messages")
                return body
            asst = next((m for m in reversed(messages) if m.get("role") == "assistant"), None)
            if not asst:
                logger.info("OUTLET_EXIT: no assistant message")
                return body
            asst_text = _extract_assistant_text(asst)
            logger.info(f"OUTLET_ASST: text_len={len(asst_text)}")
            if not asst_text:
                logger.info("OUTLET_EXIT: empty assistant text")
                return body
            user = next((m for m in reversed(messages) if m.get("role") == "user"), None)
            if not user:
                logger.info("OUTLET_EXIT: no user message")
                return body
            user_text_raw = strip_recall_block(user.get("content", "")).strip()
            logger.info(f"OUTLET_USER: content_len={len(user_text_raw)}")
            if not user_text_raw:
                logger.info("OUTLET_EXIT: empty user text")
                return body
            if "--private" in user_text_raw.lower():
                logger.info("Skipped storage due to --private flag")
                return body
            if user_text_raw.startswith("Respond with exactly the following text and nothing else"):
                logger.info("Skipped storage for inline control prompt")
                return body
            user_text = user_text_raw.strip()
            if re.match(r"^(recall|memory|knowledge|source)\s*[:\-]", user_text, re.I):
                logger.info("OUTLET_EXIT: command message (not stored)")
                return body
            if user_text.startswith("/"):
                logger.info("OUTLET_EXIT: slash command (not stored)")
                return body

            user_text_full = user_text
            asst_text_full = asst_text
            embed_input = (f"User: {truncate_chars(user_text, MAX_EMBED_USER_CHARS)}\n"
                          f"Assistant: {truncate_chars(asst_text, MAX_EMBED_ASST_CHARS)}")
            v = embed(embed_input)
            if v is None:
                logger.info("OUTLET_EXIT: embed failed")
                return body
            conv_id = get_conversation_id(body)

            with db_connect() as conn:
                recent = conn.execute(
                    "SELECT embedding FROM memories WHERE user_id=? AND deleted_at IS NULL "
                    "AND embedding_model=? AND embedding_dim=? ORDER BY id DESC LIMIT 5",
                    (user_id, EMBED_MODEL_NAME, EMBED_DIM)).fetchall()
                for (blob,) in recent:
                    if not blob:
                        continue
                    try:
                        prev = np.frombuffer(blob, dtype=np.float32)
                        if prev.shape[0] == EMBED_DIM and float(np.dot(v, prev)) > DEDUP_THRESHOLD:
                            logger.info("Skipped duplicate memory")
                            return body
                    except Exception:
                        continue
                cur = conn.execute(
                    "INSERT INTO memories(user_id, conversation_id, user_msg, assistant_msg, summary, embedding, embedding_model, embedding_dim) VALUES (?,?,?,?,?,?,?,?)",
                    (user_id, conv_id, user_text_full, asst_text_full, embed_input, v.tobytes(), EMBED_MODEL_NAME, EMBED_DIM))
                mem_id = cur.lastrowid
                conn.commit()

            self._write_obsidian(conv_id, user_id, user_text_full, asst_text_full)
            logger.info(f"Stored memory mem_{mem_id} for {user_id} (conv {conv_id[:8]}) user_len={len(user_text_full)} asst_len={len(asst_text_full)}")

        except Exception as e:
            logger.error(f"outlet error: {e}")
        return body

    @staticmethod
    def _write_obsidian(conv_id, user_id, user_text, asst_text):
        try:
            folder = os.path.join(VAULT_DIR, "conversations")
            os.makedirs(folder, exist_ok=True)
            short = hashlib.sha1(conv_id.encode()).hexdigest()[:8]
            date = datetime.now(timezone.utc).strftime("%Y%m%d")
            fname = f"{date}_{user_id[:8]}_{short}.md"
            path = os.path.join(folder, fname)
            ts = datetime.now(timezone.utc).isoformat(timespec="seconds")
            entry = f"\n## {ts}\n\n**User:** {user_text}\n\n**Assistant:** {asst_text}\n"
            mode = "a" if os.path.exists(path) else "w"
            with open(path, mode, encoding="utf-8") as f:
                if mode == "w":
                    f.write(f"# Conversation {conv_id}\n")
                f.write(entry)
        except Exception as e:
            logger.warning(f"Obsidian write failed: {e}")
