def cmd_memory_transcript(user_id, target):
    try:
        mid = int(target.strip())
    except ValueError:
        return "Usage: memory transcript: <id>"
    with db_connect() as conn:
        row = conn.execute(
            "SELECT conversation_id FROM memories WHERE id=? AND user_id IN (?, ?) AND deleted_at IS NULL",
