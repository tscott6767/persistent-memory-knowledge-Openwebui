# ── v4.1 Feature 7a: memory get command ──
def cmd_memory_get(user_id, target):
    target = target.strip()
    target_clean = target.replace("mem_", "").replace("MEM_", "").strip()
    if target_clean.isdigit():
        mem_id = int(target_clean)
        with db_connect() as conn:
            row = conn.execute(
                "SELECT id, user_msg, assistant_msg, tags, timestamp, "
                "conversation_id, use_count, pinned "
                "FROM memories WHERE id=? AND user_id IN (?, ?) AND deleted_at IS NULL",
                (mem_id, user_id, HOUSEHOLD_USER_ID)).fetchone()
        if not row:
            return f"❌ No memory found with ID mem_{mem_id}"
        return _format_memory_full(row)
    else:
        hits = search_memories(target, user_id, EXPLICIT_RECALL_MIN_SIM, top_k=5)
        full_detail_tags = load_full_detail_tags()
        tagged_hits = [h for h in hits if h.get("tags") & full_detail_tags]
        search_hits = tagged_hits if tagged_hits else hits
        if search_hits:
            top = search_hits[0]
            with db_connect() as conn:
                row = conn.execute(
                    "SELECT id, user_msg, assistant_msg, tags, timestamp, "
                    "conversation_id, use_count, pinned "
                    "FROM memories WHERE id=? AND user_id IN (?, ?) AND deleted_at IS NULL",
                    (top["id"], user_id, HOUSEHOLD_USER_ID)).fetchone()
            if row:
                return _format_memory_full(row)
        return f"❌ No memories found matching '{target}'"


