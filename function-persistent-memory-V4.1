MAX_WORDS_PER_KNOWLEDGE = 220
RECALL_TOKEN_BUDGET = 2500
RECENCY_HALFLIFE_DAYS = 30
DEDUP_THRESHOLD = 0.88
SEARCH_DEDUP_THRESHOLD = 0.93

MAX_KNOWLEDGE_CHARS = 200_000
LIST_SNIPPET_CHARS = 400
KNOWLEDGE_SEARCH_WORDS = 120

